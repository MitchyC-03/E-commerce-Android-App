        flowerList.add(new Flower("Spider Lilies", "$14.50", R.drawable.spider_lilies));
        flowerList.add(new Flower("Lilies of the valley", "$10.50", R.drawable.lily_of_the_valley));
        flowerList.add(new Flower("Skeleton Flower", "$11.50", R.drawable.skeleton_flower));


        // Set adapter
        flowerAdapter = new FlowerAdapter(this, flowerList);
        flowerListView.setAdapter(flowerAdapter);
    }
}
